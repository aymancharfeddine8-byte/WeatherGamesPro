<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shootingLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">

    <!-- HUD / Stats at Top -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center"
        android:elevation="10dp"
        android:background="#44000000">

        <TextView
            android:id="@+id/tvShootingTurn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready?"
            android:textColor="#FFEB3B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShootingScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvShootingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time: 30"
            android:textColor="#FFCDD2"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Game Area -->
    <FrameLayout
        android:id="@+id/targetArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/targetContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/target_ring_white" />

            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/target_ring_red" />

            <View
                android:id="@+id/bullseye"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center"
                android:background="@drawable/target_ring_yellow" />
        </FrameLayout>

        <!-- Moving Crosshair -->
        <ImageView
            android:id="@+id/ivCrosshair"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/crosshair"
            android:visibility="gone"
            android:elevation="5dp" />
    </FrameLayout>

    <!-- Visual Gun Barrel -->
    <View
        android:id="@+id/vGunBarrel"
        android:layout_width="40dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="#424242"
        android:elevation="4dp" />

    <!-- Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <Button
            android:id="@+id/btnFire"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:text="FIRE!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:elevation="10dp" />

        <Button
            android:id="@+id/btnStartShooting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="START CHALLENGE"
            android:padding="20dp"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF"/>
    </RelativeLayout>

</FrameLayout>